# Copy this file to .env and edit. Every value is optional; defaults are in promptshield/config.py.

# Local LLM (Ollama). Used by the LLM judge and the demo agent.
PS_OLLAMA_URL=http://localhost:11434
PS_OLLAMA_MODEL=qwen2.5:3b

# Optional cloud fallback for the LLM judge (only ever send synthetic test data to it).
# Get a free key at console.groq.com. Leave empty to disable.
PS_GROQ_API_KEY=
PS_GROQ_MODEL=llama-3.1-8b-instant

# Injection classifier. Prompt Guard 2 needs you to accept Meta's license on Hugging Face first;
# the ProtectAI model downloads without approval.
PS_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# PS_CLASSIFIER_MODEL=meta-llama/Llama-Prompt-Guard-2-22M

# Embedding model for the similarity signal.
PS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Turn signals off (1 = off). Useful on slow laptops.
PS_DISABLE_CLASSIFIER=0
PS_DISABLE_EMBEDDINGS=0
PS_DISABLE_JUDGE=0
